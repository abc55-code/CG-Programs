#VRML V2.0 utf8
WorldInfo {
    title "Sphere and Cube"
}
Viewpoint {
    position 0 0 10
}
# Red Sphere
Transform {
    translation -2 0 0
    children [
        Shape {
            appearance Appearance {
                material Material {
                    diffuseColor 1 0 0
                }
            }
            geometry Sphere {
                radius 1.5
            }
        }
    ]
}
# Blue Cube
Transform {
    translation 2 0 0
    children [
        Shape {
            appearance Appearance {
                material Material {
                    diffuseColor 0 0 1
                }
            }
            geometry Box {
                size 2 2 2
            }
        }
    ]
}
            
